# Virtual environment
.venv/

# API keys – NEVER commit these
config/api_keys.json

# Logs
logs/
*.log

# Ollama / Vosk models (large binary files)
ollama_local/
vosk_model/

# Python cache
__pycache__/
*.pyc
*.pyo

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
# Gmail OAuth secrets
config/gmail_credentials.json
config/gmail_token.pickle

# Real memory – do not commit
memory/long_term.json
memory/skills/

# Large external binaries
tools/nuclei/nuclei.exe

# User shortcuts
memory/shortcuts.json

# Gmail email plugin token
config/gmail_token_email.pickle
tools/dnsx/
tools/katana/
tools/subfinder/
tools/amass/
tools/trufflehog/
tools/whatweb/
chrome_profile/
.coverage
memory/codebase_index.json
memory/session_summary.json
memory/reflection_log.json
