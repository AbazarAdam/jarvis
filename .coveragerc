[run]
source =
    actions
    agent
    memory
    core
    plugins

omit =
    .venv/*
    tests/*
    tools/*
    scripts/*
    */__pycache__/*
    config/*
    main.py
    ui.py
    server.py
    offline_voice.py
    or_client.py
    groq_client.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug:
    if __name__ == .__main__.: